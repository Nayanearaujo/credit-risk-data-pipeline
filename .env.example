# ============================================================
# Variáveis de ambiente — copie para .env e preencha
# NÃO faça commit do arquivo .env real (já está no .gitignore)
# ============================================================

# --- Banco de Dados PostgreSQL (opcional) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_risk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui

# --- DuckDB ---
DUCKDB_PATH=./data/credit_risk.duckdb

# --- Caminhos das camadas ---
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold

# --- API Banco Central do Brasil ---
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.432/dados

# --- IA Generativa (módulo bônus) ---
# GEMINI_API_KEY=sua_chave_aqui
# OPENAI_API_KEY=sua_chave_aqui
